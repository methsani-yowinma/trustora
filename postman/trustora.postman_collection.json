{
  "info": {
    "name": "Trustora API",
    "description": "Set `accessToken` to a Supabase access token (e.g. from the browser session or `supabase.auth.getSession()`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('database ok', () => pm.expect(pm.response.json().database).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me (no token → 401)",
      "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/me" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('error envelope', () => pm.expect(pm.response.json().error.code).to.eql('unauthorized'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": { "method": "GET", "url": "{{baseUrl}}/me" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
        }
      ]
    },
    {
      "name": "Update me",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/me",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"නිමල් පෙරේරා\",\n  \"preferred_locale\": \"si\"\n}" }
      }
    },
    {
      "name": "Update me — role escalation rejected (422)",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/me",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"role\": \"ADMIN\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('422', () => pm.response.to.have.status(422));"] }
        }
      ]
    }
  ]
}

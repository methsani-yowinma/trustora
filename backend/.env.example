# Copy to backend/.env and fill in. Never commit .env.

# development | test | production  (production hides /docs and error details)
APP_ENV=development

# Supabase project settings → API
SUPABASE_URL=
# Server-side only. Used from Phase 3 (Storage). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the project still signs JWTs with the legacy HS256 secret.
# Projects using JWT signing keys (asymmetric) are verified via JWKS and leave this empty.
SUPABASE_JWT_SECRET=

# Supabase → Connect → Session pooler (port 5432) connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Google Gemini. Server-side only. Leave empty to run without AI (template explanations,
# no automatic analysis). Use a paid-tier key before processing real customer data.
GEMINI_API_KEY=
# Optional: override the default model id.
GEMINI_MODEL=
# Optional, comma-separated. Used when the main model is busy or retired.
# Default: gemini-3.5-flash-lite,gemini-flash-lite-latest. Set to 'none' to disable.
GEMINI_FALLBACK_MODELS=
